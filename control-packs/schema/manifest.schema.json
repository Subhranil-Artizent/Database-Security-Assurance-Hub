{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegisdb.example/schemas/control-pack-manifest/1.0.0",
  "title": "AegisDB immutable control-pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "generated_at", "immutability", "packs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"const": "aegisdb.control-pack-manifest"},
    "generated_at": {"type": "string", "format": "date-time"},
    "immutability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_files", "digest_algorithm", "digest_input", "replacement_policy"],
      "properties": {
        "version_files": {"const": "append_only"},
        "digest_algorithm": {"const": "sha256"},
        "digest_input": {"const": "raw_file_bytes"},
        "replacement_policy": {"const": "new_semantic_version_required"}
      }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pack_id", "version", "platform", "path", "sha256", "status"],
        "properties": {
          "pack_id": {
            "type": "string",
            "pattern": "^aegisdb\\.database-security\\.(oracle|postgresql|sybase|mysql)$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "platform": {"enum": ["oracle", "postgresql", "sybase", "mysql"]},
          "path": {
            "type": "string",
            "pattern": "^packs/(oracle|postgresql|sybase|mysql)/database-security/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.json$"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["active", "deprecated"]}
        }
      }
    }
  }
}
